---
import AboutTrust from "../components/AboutTrust.astro";
import Contact from "../components/Contact.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";

const visibleSections = siteConfig.landing.sections.filter((section) => section.enabled !== false);
---

<BaseLayout site={siteConfig}>
  <Header
    brand={siteConfig.brand}
    header={siteConfig.header}
    navigation={siteConfig.navigation}
  />
  <main id="main-content">
    {
      visibleSections.map((section) => {
        if (section.id === "hero") {
          return <Hero hero={siteConfig.hero} />;
        }

        if (section.id === "services") {
          return <Services intro={siteConfig.servicesIntro} services={siteConfig.services} />;
        }

        if (section.id === "aboutTrust") {
          return <AboutTrust about={siteConfig.about} trust={siteConfig.trust} />;
        }

        if (section.id === "cta") {
          return <CTA cta={siteConfig.cta} />;
        }

        if (section.id === "contact") {
          return <Contact contact={siteConfig.contact} />;
        }

        return null;
      })
    }
  </main>
  <Footer brand={siteConfig.brand} footer={siteConfig.footer} />
</BaseLayout>
