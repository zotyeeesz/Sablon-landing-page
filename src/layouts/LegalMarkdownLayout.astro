---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "./BaseLayout.astro";
import { site } from "../data/site";

interface Props {
  frontmatter: {
    title: string;
    description: string;
  };
}

const { frontmatter } = Astro.props;

const nav = site.nav.map((item) => ({
  ...item,
  href: `/${item.href}`,
}));

const footerLinks = site.footer.links.map((item) => ({
  ...item,
  href: item.href.startsWith("#") ? `/${item.href}` : item.href,
}));
---

<BaseLayout title={`${frontmatter.title} | ${site.brand.name}`} description={frontmatter.description}>
  <Header brand={site.brand} nav={nav} contact={site.contact} />
  <main id="main-content">
    <section class="legal-document">
      <div class="legal-document__inner">
        <a class="legal-document__back" href="/">Vissza a főoldalra</a>
        <article class="legal-document__content">
          <slot />
        </article>
      </div>
    </section>
  </main>
  <Footer brand={site.brand} links={footerLinks} />
</BaseLayout>

<style>
  .legal-document {
    background:
      linear-gradient(180deg, rgba(127, 153, 127, 0.14), transparent 18rem),
      #fff;
    padding: 5.5rem 1.25rem 6rem;
  }

  .legal-document__inner {
    width: min(100%, 900px);
    margin: 0 auto;
  }

  .legal-document__back {
    display: inline-flex;
    margin-bottom: 2rem;
    color: var(--color-muted);
    font-weight: 760;
  }

  .legal-document__back:hover {
    color: var(--color-accent-strong);
  }

  .legal-document__content {
    color: var(--color-ink);
  }

  .legal-document__content :global(h1) {
    max-width: 760px;
    margin: 0 0 1rem;
    font-size: 3.1rem;
    font-weight: 820;
    letter-spacing: 0;
    line-height: 1;
  }

  .legal-document__content :global(h2) {
    margin: 3rem 0 1rem;
    padding-top: 1.35rem;
    border-top: 1px solid var(--color-line);
    font-size: 1.55rem;
    letter-spacing: 0;
    line-height: 1.18;
  }

  .legal-document__content :global(h3) {
    margin: 2rem 0 0.7rem;
    font-size: 1.08rem;
    letter-spacing: 0;
    line-height: 1.3;
  }

  .legal-document__content :global(p),
  .legal-document__content :global(li) {
    color: #43534b;
    font-size: 1rem;
  }

  .legal-document__content :global(p) {
    margin: 0.75rem 0;
  }

  .legal-document__content :global(ul) {
    margin: 0.8rem 0 1.2rem;
    padding-left: 1.25rem;
  }

  .legal-document__content :global(a) {
    color: var(--color-accent-strong);
    font-weight: 720;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .legal-document__content :global(strong) {
    color: var(--color-ink);
  }

  @media (max-width: 760px) {
    .legal-document {
      padding: 4rem 1rem 4.5rem;
    }

    .legal-document__content :global(h1) {
      font-size: 2.35rem;
    }

    .legal-document__content :global(h2) {
      font-size: 1.35rem;
    }
  }
</style>
