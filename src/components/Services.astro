---
interface Service {
  title: string;
  text: string;
}

interface Props {
  intro: {
    eyebrow: string;
    title: string;
    lead: string;
  };
  services: Service[];
}

const { intro, services } = Astro.props;
---

<section class="section services" id="services" aria-labelledby="services-title">
  <div class="section__inner">
    <div class="section__header">
      <p class="section__eyebrow">{intro.eyebrow}</p>
      <h2 class="section__title" id="services-title">{intro.title}</h2>
      <p class="section__lead">{intro.lead}</p>
    </div>

    <div class="services__grid">
      {
        services.map((service, index) => (
          <article class="service-card">
            <span class="service-card__index" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    background:
      linear-gradient(180deg, #f7f8f3 0%, #ffffff 34%, #ffffff 100%);
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-line);
    box-shadow: var(--shadow-soft);
  }

  .service-card {
    min-height: 19rem;
    background: #fff;
    padding: 1.6rem;
  }

  .service-card__index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 6px;
    background: var(--color-surface-strong);
    color: var(--color-blue);
    font-size: 0.82rem;
    font-weight: 850;
    line-height: 1;
  }

  .service-card h3 {
    min-height: 3.2rem;
    margin: 1.4rem 0 0;
    font-size: 1.2rem;
    letter-spacing: 0;
    line-height: 1.28;
  }

  .service-card p {
    margin: 1rem 0 0;
    color: var(--color-muted);
    font-size: 0.96rem;
  }

  @media (max-width: 980px) {
    .services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .services__grid {
      grid-template-columns: 1fr;
    }

    .service-card {
      min-height: auto;
      padding: 1.35rem;
    }

    .service-card h3 {
      min-height: auto;
    }
  }
</style>
