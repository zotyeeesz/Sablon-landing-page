---
import type { ContactConfig } from "../types/site";

interface Props {
  contact: ContactConfig;
}

const { contact } = Astro.props;
const phoneHref = contact.phone?.replace(/[^\d+]/g, "");
---

<section class="contact section" id="contact" aria-labelledby="contact-title">
  <div class="section__inner contact__grid">
    <div class="contact__intro">
      <p class="section__eyebrow">{contact.eyebrow}</p>
      <h2 class="section__title" id="contact-title">{contact.title}</h2>
      {contact.lead && <p class="section__lead">{contact.lead}</p>}

      <div class="contact__details" aria-label="Elérhetőségek">
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
        {contact.phone && <a href={`tel:${phoneHref}`}>{contact.phone}</a>}
        {contact.city && <span>{contact.city}</span>}
      </div>
    </div>

    <form
      class="contact__form"
      action={contact.form.action}
      method={contact.form.method}
      enctype={contact.form.enctype}
    >
      {
        contact.form.fields.map((field) => (
          <div class="field">
            <label for={field.id}>{field.label}</label>
            {field.type === "textarea" ? (
              <textarea
                id={field.id}
                name={field.name}
                rows={field.rows ?? 5}
                placeholder={field.placeholder}
                required={field.required}
              ></textarea>
            ) : (
              <input
                id={field.id}
                name={field.name}
                type={field.type ?? "text"}
                autocomplete={field.autocomplete}
                placeholder={field.placeholder}
                required={field.required}
              />
            )}
          </div>
        ))
      }

      <button class="button button--primary" type="submit">{contact.form.submitLabel}</button>
    </form>
  </div>
</section>

<style>
  .contact {
    background: var(--color-surface);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(22rem, 0.72fr);
    gap: 4rem;
    align-items: start;
  }

  .contact__details {
    display: grid;
    gap: 0.65rem;
    margin-top: 2rem;
  }

  .contact__details a,
  .contact__details span {
    width: fit-content;
    color: var(--color-ink);
    font-weight: 760;
  }

  .contact__details a {
    border-bottom: 1px solid var(--color-contact-link-line);
  }

  .contact__details a:hover {
    color: var(--color-accent-strong);
  }

  .contact__form {
    display: grid;
    gap: 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-bg);
    padding: 1.4rem;
    box-shadow: var(--shadow-soft);
  }

  .field {
    display: grid;
    gap: 0.42rem;
  }

  label {
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 760;
  }

  input,
  textarea {
    width: 100%;
    border: 1px solid var(--color-field-line);
    border-radius: 6px;
    background: var(--color-surface);
    color: var(--color-ink);
    padding: 0.85rem 0.9rem;
  }

  textarea {
    min-height: 10rem;
    resize: vertical;
  }

  input:focus,
  textarea:focus {
    border-color: var(--color-contact-field-focus);
    outline: none;
    box-shadow: var(--shadow-contact-field-focus);
  }

  .contact__form .button {
    width: 100%;
  }

  @media (max-width: 860px) {
    .contact__grid {
      grid-template-columns: 1fr;
      gap: 2.4rem;
    }
  }

  @media (max-width: 460px) {
    .contact__form {
      padding: 1rem;
    }
  }
</style>
