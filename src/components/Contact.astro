---
interface Props {
  contact: {
    eyebrow: string;
    title: string;
    lead: string;
    email: string;
    phone: string;
    city: string;
    formAction: string;
  };
}

const { contact } = Astro.props;
---

<section class="contact section" id="contact" aria-labelledby="contact-title">
  <div class="section__inner contact__grid">
    <div class="contact__intro">
      <p class="section__eyebrow">{contact.eyebrow}</p>
      <h2 class="section__title" id="contact-title">{contact.title}</h2>
      <p class="section__lead">{contact.lead}</p>

      <div class="contact__details" aria-label="Elérhetőségek">
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
        <a href={`tel:${contact.phone.replaceAll(" ", "")}`}>{contact.phone}</a>
        <span>{contact.city}</span>
      </div>
    </div>

    <form class="contact__form" action={contact.formAction} method="post" enctype="text/plain">
      <div class="field">
        <label for="name">Név</label>
        <input id="name" name="Név" autocomplete="name" required />
      </div>

      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="Email" type="email" autocomplete="email" required />
      </div>

      <div class="field">
        <label for="message">Projekt röviden</label>
        <textarea id="message" name="Projekt" rows="5" required></textarea>
      </div>

      <button class="button button--primary" type="submit">Üzenet küldése</button>
    </form>
  </div>
</section>

<style>
  .contact {
    background: #fff;
  }

  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(22rem, 0.72fr);
    gap: 4rem;
    align-items: start;
  }

  .contact__details {
    display: grid;
    gap: 0.65rem;
    margin-top: 2rem;
  }

  .contact__details a,
  .contact__details span {
    width: fit-content;
    color: var(--color-ink);
    font-weight: 760;
  }

  .contact__details a {
    border-bottom: 1px solid rgba(199, 95, 72, 0.4);
  }

  .contact__details a:hover {
    color: var(--color-accent-strong);
  }

  .contact__form {
    display: grid;
    gap: 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-bg);
    padding: 1.4rem;
    box-shadow: var(--shadow-soft);
  }

  .field {
    display: grid;
    gap: 0.42rem;
  }

  label {
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 760;
  }

  input,
  textarea {
    width: 100%;
    border: 1px solid #cfd9ce;
    border-radius: 6px;
    background: #fff;
    color: var(--color-ink);
    padding: 0.85rem 0.9rem;
  }

  textarea {
    min-height: 10rem;
    resize: vertical;
  }

  input:focus,
  textarea:focus {
    border-color: rgba(199, 95, 72, 0.78);
    outline: none;
    box-shadow: 0 0 0 4px rgba(199, 95, 72, 0.12);
  }

  .contact__form .button {
    width: 100%;
  }

  @media (max-width: 860px) {
    .contact__grid {
      grid-template-columns: 1fr;
      gap: 2.4rem;
    }
  }

  @media (max-width: 460px) {
    .contact__form {
      padding: 1rem;
    }
  }
</style>
