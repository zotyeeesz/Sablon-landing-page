---
import type { CtaConfig } from "../types/site";

interface Props {
  cta: CtaConfig;
}

const { cta } = Astro.props;
---

<section class="cta section section--tight" aria-labelledby="cta-title">
  <div class="section__inner cta__inner">
    <div>
      <p class="section__eyebrow">{cta.eyebrow}</p>
      <h2 id="cta-title">{cta.title}</h2>
      <p>{cta.text}</p>
    </div>

    <div class="cta__actions" aria-label="Következő lépések">
      <a class="button button--primary" href={cta.primaryAction.href}>{cta.primaryAction.label}</a>
      {
        cta.secondaryAction && (
          <a class="button button--secondary" href={cta.secondaryAction.href}>
            {cta.secondaryAction.label}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta {
    border-block: 1px solid var(--color-line);
    background:
      linear-gradient(90deg, var(--color-cta-accent-bg), transparent 44%),
      var(--color-surface-strong);
  }

  .cta__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: center;
  }

  .cta h2 {
    max-width: 780px;
    margin: 0;
    font-size: 2rem;
    letter-spacing: 0;
    line-height: 1.12;
  }

  .cta p:not(.section__eyebrow) {
    max-width: 660px;
    margin: 1rem 0 0;
    color: var(--color-muted);
  }

  .cta__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: min(100%, 18rem);
  }

  @media (max-width: 860px) {
    .cta__inner {
      grid-template-columns: 1fr;
    }

    .cta__actions {
      width: min(100%, 22rem);
    }
  }

  @media (max-width: 620px) {
    .cta h2 {
      font-size: 1.65rem;
    }
  }
</style>
