---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  hero: {
    eyebrow: string;
    title: string;
    lead: string;
    image: {
      src: string;
      alt: string;
    };
    primaryAction: {
      label: string;
      href: string;
    };
    secondaryAction: {
      label: string;
      href: string;
    };
    stats: Stat[];
  };
}

const { hero } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__visual" aria-hidden="true">
    <img src={hero.image.src} alt={hero.image.alt} loading="eager" decoding="async" />
  </div>

  <div class="hero__inner">
    <div class="hero__content">
      <p class="hero__eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-title">{hero.title}</h1>
      <p class="hero__lead">{hero.lead}</p>

      <div class="hero__actions" aria-label="Elsődleges műveletek">
        <a class="button button--primary" href={hero.primaryAction.href}>{hero.primaryAction.label}</a>
        <a class="button button--secondary" href={hero.secondaryAction.href}>{hero.secondaryAction.label}</a>
      </div>

      <dl class="hero__stats" aria-label="Rövid ígéretek">
        {
          hero.stats.map((stat) => (
            <div class="hero__stat">
              <dt>{stat.value}</dt>
              <dd>{stat.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 68svh;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    background: #f4f5ef;
  }

  .hero::after {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(247, 248, 243, 0.97) 0%, rgba(247, 248, 243, 0.9) 42%, rgba(247, 248, 243, 0.18) 78%),
      linear-gradient(180deg, rgba(247, 248, 243, 0.16) 0%, rgba(247, 248, 243, 0.7) 100%);
    content: "";
  }

  .hero__visual {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__inner {
    display: grid;
    align-items: center;
    width: min(100%, var(--container));
    min-height: 68svh;
    margin: 0 auto;
    padding: 5.25rem 1.25rem 4.6rem;
  }

  .hero__content {
    width: min(100%, 660px);
  }

  .hero__eyebrow {
    margin: 0 0 1rem;
    color: var(--color-accent-strong);
    font-size: 0.86rem;
    font-weight: 850;
    letter-spacing: 0;
    line-height: 1.35;
    text-transform: uppercase;
  }

  h1 {
    max-width: 11ch;
    margin: 0;
    font-size: 4.6rem;
    font-weight: 820;
    letter-spacing: 0;
    line-height: 0.96;
  }

  .hero__lead {
    max-width: 620px;
    margin: 1.35rem 0 0;
    color: #4f5f57;
    font-size: 1.16rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    max-width: 620px;
    margin: 2.3rem 0 0;
    padding: 0;
  }

  .hero__stat {
    border-left: 2px solid rgba(199, 95, 72, 0.42);
    padding-left: 0.85rem;
  }

  .hero__stat dt {
    margin: 0;
    font-size: 1rem;
    font-weight: 850;
    line-height: 1.2;
  }

  .hero__stat dd {
    margin: 0.32rem 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.35;
  }

  @media (max-width: 900px) {
    .hero::after {
      background:
        linear-gradient(90deg, rgba(247, 248, 243, 0.98) 0%, rgba(247, 248, 243, 0.88) 70%, rgba(247, 248, 243, 0.38) 100%),
        linear-gradient(180deg, rgba(247, 248, 243, 0.18) 0%, rgba(247, 248, 243, 0.82) 100%);
    }

    h1 {
      font-size: 3.45rem;
    }
  }

  @media (max-width: 620px) {
    .hero,
    .hero__inner {
      min-height: 64svh;
    }

    .hero__inner {
      padding: 3.65rem 1rem 3.3rem;
    }

    .hero__visual img {
      object-position: 63% center;
    }

    h1 {
      max-width: 10ch;
      font-size: 2.55rem;
      line-height: 1.02;
    }

    .hero__lead {
      font-size: 1rem;
    }

    .hero__actions {
      align-items: stretch;
      flex-direction: column;
      max-width: 21rem;
    }

    .hero__stats {
      grid-template-columns: 1fr;
      gap: 0.8rem;
      margin-top: 1.8rem;
    }
  }
</style>
