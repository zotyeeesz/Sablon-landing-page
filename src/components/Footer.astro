---
interface FooterLink {
  label: string;
  href: string;
}

interface Props {
  brand: {
    name: string;
  };
  links: FooterLink[];
}

const { brand, links } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner">
    <p>© {year} {brand.name}. Minden jog fenntartva.</p>
    <nav class="footer__nav" aria-label="Lábléc navigáció">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-line);
    background: var(--color-bg);
    color: var(--color-muted);
  }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(100%, var(--container));
    margin: 0 auto;
    padding: 1.6rem 1.25rem;
  }

  .footer p {
    margin: 0;
  }

  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .footer__nav a {
    font-weight: 720;
  }

  .footer__nav a:hover {
    color: var(--color-ink);
  }

  @media (max-width: 680px) {
    .footer__inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
