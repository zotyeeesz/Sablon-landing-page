---
import type { BrandConfig, FooterConfig } from "../types/site";

interface Props {
  brand: BrandConfig;
  footer: FooterConfig;
}

const { brand, footer } = Astro.props;
const year = new Date().getFullYear();
const copyright = footer.copyright ?? "Minden jog fenntartva.";
---

<footer class="footer">
  <div class="footer__inner">
    <p>© {year} {brand.name}. {copyright}</p>
    {
      footer.links.length > 0 && (
        <nav class="footer__nav" aria-label="Lábléc navigáció">
          {footer.links.map((link) => (
            <a href={link.href} target={link.target} rel={link.rel}>
              {link.label}
            </a>
          ))}
        </nav>
      )
    }
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-line);
    background: var(--color-bg);
    color: var(--color-muted);
  }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(100%, var(--container));
    margin: 0 auto;
    padding: 1.6rem 1.25rem;
  }

  .footer p {
    margin: 0;
  }

  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .footer__nav a {
    font-weight: 720;
  }

  .footer__nav a:hover {
    color: var(--color-ink);
  }

  @media (max-width: 680px) {
    .footer__inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
